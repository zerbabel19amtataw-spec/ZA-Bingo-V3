{
  "rules": {
    ".read": false,
    ".write": false,

    "players": {
      ".read": "auth.token.admin === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "leaderboard": {
      ".read": "auth != null",
      ".write": false
    },

    "rooms": {
      ".read": "auth != null",
      ".write": false
    },

    "transactions": {
      ".read": "auth.token.admin === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "deposits": {
      ".read": "auth.token.admin === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "withdrawals": {
      ".read": "auth.token.admin === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "gameHistory": {
      ".read": "auth != null",
      ".write": false
    },

    "announcements": {
      ".read": "auth != null",
      ".write": false
    }
  }
}
